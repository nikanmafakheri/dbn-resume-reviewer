# Build context excludes — the Dockerfile uses the repo root as context, so
# keep it lean and avoid leaking secrets/state into the image.

# Environment files (secret)
.env
.env.*
backend/.env

# Local state
*.db
*.db-*
*.sqlite*
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/media/

# Virtualenvs
.venv/
venv/
env/

# Node / JS (frontend is built separately on Render, not in the API image)
node_modules/
frontend/node_modules/
frontend/dist/

# Docs / static assets not needed in the API image
docs/
images/
graphify-out/
.claude/