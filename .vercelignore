# Vercel build-upload exclusions — keep the upload lean and never ship secrets/state.

# Secrets
backend/.env
.env
.env.*
*.env

# Local SQLite dev databases
*.db
*.db-*
backend/*.db

# Backend test + lint artifacts
backend/tests/
backend/.pytest_cache/
backend/.ruff_cache/
**/__pycache__/
*.py[cod]

# Backend local uploads (serverless stores text in Neon instead)
backend/media/

# Frontend build output + deps (installed during build)
frontend/node_modules/
frontend/dist/

# VCS / editor / OS
.git/
.gitignore
.github/
.vscode/
.idea/
*.log
.DS_Store

# Docs / generated assets not needed at runtime
docs/
images/
graphify-out/
.claude/
CLAUDE.md