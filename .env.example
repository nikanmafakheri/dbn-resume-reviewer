# ── App ──
APP_NAME=DBN Resume Reviewer
APP_URL=http://localhost:8000
DEBUG=true

# ── Database ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dbn_resume

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security ──
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=["http://localhost:3000"]

# ── LLM Provider (gemini | openai | claude | openrouter) ──
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=

# ── Email (optional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@dbnresume.com

# ── Idempotency ──
IDEMPOTENCY_TTL=86400